## 운영 프로파일 — 예시 파일
##
## 사용법: 본 파일을 application-prod.yml 로 복사한 후 값을 자기 환경에 맞춰 수정.
## application-prod.yml 은 .gitignore 에 의해 커밋 대상이 아니다.
##
## 운영 시크릿은 가급적 환경변수(SALESON_*) 로 주입하고 본 파일에는 평문으로 두지 말 것.
## application.yml 의 ${SALESON_*:default} 표기 참조.

saleson:
  file:
    # 운영: 다운로드는 nginx X-Accel-Redirect 위임 권장.
    # internal-location 은 nginx conf 의 `location /download/ { internal; alias ...; }` 와 일치해야 함.
    xaccel:
      enabled: true
      internal-location: /download/
  primary:
    datasource:
      jdbc-url: jdbc:postgresql://your-db-host:5432/your_db_name
      driver-class-name: org.postgresql.Driver
      username: ${SALESON_DB_USER:your_db_user}
      password: ${SALESON_DB_PASS:CHANGE_ME}
  claude:
    api-key: ${SALESON_CLAUDE_API_KEY:}
  openai:
    api-key: ${SALESON_OPENAI_API_KEY:}

logging:
  level:
    com.saleson: INFO
    org.springframework: WARN
