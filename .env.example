# ============================================
# FORMA 운영 환경변수 (.env)
# 이 파일을 .env로 복사 후 값을 수정하세요
# ============================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database (application-prod.yml 의 ${FORMA_DB_*:...} 기본값을 덮어쓸 때만 채움)
# FORMA_DB_URL=jdbc:postgresql://your-db-host:5432/your_db_name
# FORMA_DB_USER=forma
# FORMA_DB_PASS=변경필요

# JWT (최소 32자 이상 랜덤 문자열)
FORMA_JWT_SECRET=변경필요_openssl_rand_base64_48_로_생성
FORMA_JWT_VALID_SECONDS=2592000

# File Upload
FORMA_UPLOAD_PATH=/app/uploads

# CORS (도메인, 쉼표 구분)
FORMA_CORS_ORIGINS=https://your-domain.com

# AI API Key
FORMA_OPENAI_API_KEY=
FORMA_CLAUDE_API_KEY=

# JVM
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC
