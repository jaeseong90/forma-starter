# ============================================
# SalesOn 운영 환경변수 (.env)
# 이 파일을 .env로 복사 후 값을 수정하세요
# ============================================

# Spring Profile
SPRING_PROFILES_ACTIVE=prod

# Database (application-prod.yml에 하드코딩되어 있어 현재 미사용 — 참고용)
# SALESON_DB_URL=jdbc:postgresql://10.0.1.163:15432/salesondb
# SALESON_DB_USER=saleson
# SALESON_DB_PASS=변경필요

# JWT (최소 32자 이상 랜덤 문자열)
SALESON_JWT_SECRET=변경필요_openssl_rand_base64_48_로_생성
SALESON_JWT_VALID_SECONDS=2592000

# File Upload
SALESON_UPLOAD_PATH=/app/uploads

# CORS (도메인, 쉼표 구분)
SALESON_CORS_ORIGINS=https://your-domain.com

# AI API Key
SALESON_OPENAI_API_KEY=
SALESON_CLAUDE_API_KEY=

# JVM
JAVA_OPTS=-Xmx512m -Xms256m -XX:+UseG1GC
